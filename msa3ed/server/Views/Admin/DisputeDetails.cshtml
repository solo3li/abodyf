@model Uis.Server.Models.Dispute
@{
    ViewData["Title"] = "تفاصيل النزاع";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold">تفاصيل النزاع - طلب #@Model.OrderId.ToString().Substring(0, 8)</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="text-xs text-secondary text-uppercase font-weight-bold opacity-7">فتح بواسطة</label>
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(Model.OpenedByUser.ProfilePicture) ? "/img/default-avatar.png" : Model.OpenedByUser.ProfilePicture)" class="avatar avatar-sm me-3 border-radius-lg" alt="user">
                                <h6 class="mb-0 text-sm">@Model.OpenedByUser.FullName</h6>
                            </div>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <label class="text-xs text-secondary text-uppercase font-weight-bold opacity-7">تاريخ الفتح</label>
                            <h6 class="mb-0 text-sm">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</h6>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-sm fw-bold">وصف المشكلة</label>
                        <div class="p-3 bg-light rounded border text-sm">
                            @Model.Description
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-sm fw-bold">الأدلة المرفقة</label>
                        <div class="text-center border rounded p-3 bg-light">
                            <a href="@Model.EvidenceUrl" target="_blank">
                                <img src="@Model.EvidenceUrl" class="img-fluid rounded shadow-sm" style="max-height: 400px;" alt="Evidence">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold">اتخاذ قرار</h5>
                </div>
                <div class="card-body">
                    @if (Model.Status == "Open")
                    {
                        <form action="@Url.Action("ResolveDispute", new { id = Model.Id })" method="post">
                            <div class="mb-3">
                                <label class="form-label text-sm fw-bold">نوع القرار</label>
                                <select name="resolution" class="form-select" required>
                                    <option value="">اختر القرار المناسب...</option>
                                    <option value="RefundToStudent">إلغاء الطلب وإعادة المبلغ للطالب</option>
                                    <option value="ReleaseToExecutor">اعتبار الطلب مكتملاً وتحويل المستحقات للمنفذ</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-sm fw-bold">ملاحظات الإدارة</label>
                                <textarea name="adminNotes" class="form-control" rows="4" placeholder="اكتب مبررات القرار هنا..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">تنفيذ القرار وإغلاق النزاع</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <div class="avatar avatar-xl bg-gradient-success shadow-success border-radius-xl mb-3 mx-auto">
                                <i class="fas fa-check text-white" style="font-size: 2rem;"></i>
                            </div>
                            <h5 class="fw-bold text-success">تم حل النزاع</h5>
                            <p class="text-sm text-secondary">
                                تاريخ الحل: @Model.ResolvedAt?.ToString("yyyy-MM-dd HH:mm")<br>
                                نوع القرار: @(Model.ResolutionType == "RefundToStudent" ? "إعادة المبلغ للطالب" : "تحويل المستحقات للمنفذ")
                            </p>
                        </div>
                        <hr class="horizontal dark">
                        <div class="mb-3">
                            <label class="text-xs text-secondary text-uppercase font-weight-bold opacity-7">ملاحظات الإدارة</label>
                            <p class="text-sm">@(string.IsNullOrEmpty(Model.AdminNotes) ? "لا توجد ملاحظات" : Model.AdminNotes)</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold">أطراف النزاع</h5>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex mb-3">
                        <div class="avatar avatar-sm bg-gradient-info me-3 border-radius-lg">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <div>
                            <p class="text-xs text-secondary mb-0">الطالب</p>
                            <h6 class="text-sm mb-0">@Model.Order.Student.FullName</h6>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="avatar avatar-sm bg-gradient-dark me-3 border-radius-lg">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div>
                            <p class="text-xs text-secondary mb-0">المنفذ</p>
                            <h6 class="text-sm mb-0">@(Model.Order.Executor?.FullName ?? "غير محدد")</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
