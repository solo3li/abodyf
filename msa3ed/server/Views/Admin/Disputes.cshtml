@model IEnumerable<Uis.Server.Models.Dispute>
@{
    ViewData["Title"] = "إدارة النزاعات";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">النزاعات والشكاوى</h5>
                    <div class="btn-group">
                        <a href="@Url.Action("Disputes")" class="btn btn-outline-secondary btn-sm @(string.IsNullOrEmpty(ViewBag.Status) ? "active" : "")">الكل</a>
                        <a href="@Url.Action("Disputes", new { status = "Open" })" class="btn btn-outline-danger btn-sm @(ViewBag.Status == "Open" ? "active" : "")">نزاعات مفتوحة</a>
                        <a href="@Url.Action("Disputes", new { status = "Resolved" })" class="btn btn-outline-success btn-sm @(ViewBag.Status == "Resolved" ? "active" : "")">تم الحل</a>
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr class="bg-light">
                                    <th class="text-secondary text-xs font-weight-bold opacity-7 ps-4">الطلب</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">صاحب النزاع</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">التاريخ</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">الحالة</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <p class="text-sm font-weight-bold mb-0">#@item.OrderId.ToString().Substring(0, 8)</p>
                                            <p class="text-xs text-secondary mb-0">قيمة الطلب: @item.Order.Price.ToString("N2") ج.م</p>
                                        </td>
                                        <td>
                                            <div class="d-flex px-2 py-1">
                                                <div class="d-flex flex-column justify-content-center">
                                                    <h6 class="mb-0 text-sm">@item.OpenedByUser.FullName</h6>
                                                    <p class="text-xs text-secondary mb-0">@item.OpenedByUser.Email</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-secondary text-xs font-weight-bold">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                        </td>
                                        <td>
                                            @if (item.Status == "Open")
                                            {
                                                <span class="badge badge-sm bg-gradient-danger">مفتوح</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-sm bg-gradient-success">تم الحل</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("DisputeDetails", new { id = item.Id })" class="btn btn-link text-primary font-weight-bold text-xs">
                                                عرض التفاصيل والحل
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
