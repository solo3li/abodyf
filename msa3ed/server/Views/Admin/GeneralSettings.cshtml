@model IEnumerable<Uis.Server.Models.SystemSetting>
@{
    ViewData["Title"] = "الإعدادات العامة";
}

<div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 max-w-4xl">
    <div class="flex justify-between items-center mb-8 pb-6 border-b border-gray-50">
        <h3 class="text-xl font-black text-gray-800 flex items-center"><i class="fas fa-cog ml-3 text-indigo-500"></i> إعدادات المنصة العامة</h3>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-100 text-green-600 px-6 py-4 rounded-2xl mb-8 font-bold text-sm flex items-center">
            <i class="fas fa-check-circle ml-2"></i> @TempData["Success"]
        </div>
    }

    <form action="/Admin/Settings/General/Update" method="post" class="space-y-8">
        @foreach (var setting in Model)
        {
            <div class="space-y-3">
                <label class="text-xs font-black text-gray-400 uppercase tracking-widest mr-1">
                    @switch (setting.Key)
                    {
                        case "CommissionRate": @:نسبة العمولة (%)
                            break;
                        case "MaxWalletTopUp": @:الحد الأقصى لشحن المحفظة
                            break;
                        case "PlatformName": @:اسم المنصة
                            break;
                        default: @setting.Key
                            break;
                    }
                </label>
                <div class="relative">
                    <input type="text" class="w-full bg-gray-50 border border-gray-200 rounded-2xl px-6 py-4 text-sm font-bold text-gray-800 focus:outline-none focus:border-indigo-500 focus:bg-white transition-all" name="settings[@setting.Key]" value="@setting.Value" required />
                    <div class="absolute inset-y-0 left-6 flex items-center pointer-events-none text-gray-300 text-[10px] font-black uppercase">Technical Key: @setting.Key</div>
                </div>
                @if(setting.Key == "CommissionRate") {
                    <p class="text-[10px] text-gray-400 font-bold mr-1">النسبة المئوية التي تقتطعها المنصة من كل طلب مكتمل.</p>
                }
            </div>
        }

        @if (!Model.Any())
        {
            <div class="bg-yellow-50 border border-yellow-100 text-yellow-600 px-6 py-4 rounded-2xl font-bold text-sm">
                <i class="fas fa-exclamation-triangle ml-2"></i> لا توجد إعدادات عامة معرفة في قاعدة البيانات. يرجى تشغيل Seeder.
            </div>
        }

        <div class="pt-6 border-t border-gray-50 flex justify-end">
            <button type="submit" class="bg-indigo-600 text-white px-10 py-4 rounded-2xl font-black text-sm hover:bg-indigo-700 transition-all shadow-xl shadow-indigo-100 active:scale-95">حفظ التغييرات</button>
        </div>
    </form>
</div>
