@model IEnumerable<Uis.Server.Models.WalletTransaction>
@{
    var user = ViewBag.User as Uis.Server.Models.User;
    ViewData["Title"] = "تفاصيل المحفظة";
}

<div class="flex justify-between items-center mb-8">
    <div class="flex items-center">
        <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center ml-4">
            <i class="fas fa-wallet text-xl"></i>
        </div>
        <div>
            <h2 class="text-2xl font-black text-gray-800">تفاصيل المحفظة: @user.FullName</h2>
            <p class="text-sm text-gray-400 font-bold">@user.Email</p>
        </div>
    </div>
    <a href="/Admin/Wallet" class="bg-gray-100 text-gray-600 px-6 py-2.5 rounded-2xl font-black text-xs hover:bg-gray-200 transition-all">العودة للقائمة</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-50 border border-green-100 text-green-600 px-6 py-4 rounded-2xl mb-8 font-bold text-sm">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-50 border border-red-100 text-red-600 px-6 py-4 rounded-2xl mb-8 font-bold text-sm">@TempData["ErrorMessage"]</div>
}

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 flex flex-col justify-center">
        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">الرصيد الحالي</p>
        <h3 class="text-4xl font-black text-gray-800">@user.WalletBalance.ToString("N2") <span class="text-lg text-indigo-600 mr-1">ج.م</span></h3>
    </div>

    <div class="md:col-span-2 bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
        <h3 class="text-lg font-black text-gray-800 mb-6 flex items-center"><i class="fas fa-exchange-alt ml-3 text-indigo-500"></i> إجراء معاملة يدوية</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <form action="/Admin/WalletCredit" method="post" class="space-y-4 p-6 bg-green-50/50 rounded-2xl border border-green-100">
                <input type="hidden" name="userId" value="@user.Id" />
                <h4 class="text-xs font-black text-green-600 uppercase">إيداع رصيد</h4>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold text-gray-400 uppercase mr-1">المبلغ</label>
                    <input type="number" step="0.01" class="w-full bg-white border border-green-100 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-green-500" name="amount" required min="1" />
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold text-gray-400 uppercase mr-1">السبب</label>
                    <input type="text" class="w-full bg-white border border-green-100 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-green-500" name="reason" required />
                </div>
                <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-xl font-black text-xs hover:bg-green-700 transition-all shadow-lg shadow-green-100">إيداع رصيد</button>
            </form>

            <form action="/Admin/WalletDebit" method="post" class="space-y-4 p-6 bg-red-50/50 rounded-2xl border border-red-100">
                <input type="hidden" name="userId" value="@user.Id" />
                <h4 class="text-xs font-black text-red-600 uppercase">خصم رصيد</h4>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold text-gray-400 uppercase mr-1">المبلغ</label>
                    <input type="number" step="0.01" class="w-full bg-white border border-red-100 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-red-500" name="amount" required min="1" />
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold text-gray-400 uppercase mr-1">السبب</label>
                    <input type="text" class="w-full bg-white border border-red-100 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-red-500" name="reason" required />
                </div>
                <button type="submit" class="w-full bg-red-600 text-white py-3 rounded-xl font-black text-xs hover:bg-red-700 transition-all shadow-lg shadow-red-100">خصم رصيد</button>
            </form>
        </div>
    </div>
</div>

<div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
    <h3 class="text-lg font-black text-gray-800 mb-8 flex items-center"><i class="fas fa-history ml-3 text-indigo-500"></i> سجل المعاملات (آخر 50)</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-right">
            <thead>
                <tr class="text-[10px] font-black text-gray-400 uppercase tracking-widest border-b border-gray-50">
                    <th class="pb-4 px-4">التاريخ</th>
                    <th class="pb-4 px-4">النوع</th>
                    <th class="pb-4 px-4">المبلغ</th>
                    <th class="pb-4 px-4">الوصف</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                @foreach (var tx in Model)
                {
                    <tr class="group hover:bg-gray-50 transition-all">
                        <td class="py-5 px-4 text-xs font-bold text-gray-500">@tx.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td class="py-5 px-4">
                            @if (tx.Amount > 0)
                            {
                                <span class="bg-green-50 text-green-600 px-3 py-1 rounded-full font-black text-[9px] uppercase">إيداع</span>
                            }
                            else
                            {
                                <span class="bg-red-50 text-red-600 px-3 py-1 rounded-full font-black text-[9px] uppercase">خصم</span>
                            }
                        </td>
                        <td class="py-5 px-4 font-black @(tx.Amount > 0 ? "text-green-600" : "text-red-600")">
                            @(tx.Amount > 0 ? "+" : "")@tx.Amount.ToString("N2") ج.م
                        </td>
                        <td class="py-5 px-4 text-sm text-gray-600">@tx.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
