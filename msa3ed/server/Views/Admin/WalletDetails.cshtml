@model IEnumerable<Uis.Server.Models.WalletTransaction>
@{
    var user = ViewBag.User as Uis.Server.Models.User;
    ViewData["Title"] = "تفاصيل المحفظة";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 text-gray-800">تفاصيل المحفظة: @user.FullName</h2>
    <a href="/Admin/Wallet" class="btn btn-secondary btn-sm">العودة للقائمة</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">الرصيد الحالي</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@user.WalletBalance.ToString("C")</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-wallet fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-success">إيداع رصيد</h6>
            </div>
            <div class="card-body">
                <form action="/Admin/WalletCredit" method="post">
                    <input type="hidden" name="userId" value="@user.Id" />
                    <div class="form-group">
                        <label>المبلغ</label>
                        <input type="number" step="0.01" class="form-control" name="amount" required min="1" />
                    </div>
                    <div class="form-group">
                        <label>السبب</label>
                        <input type="text" class="form-control" name="reason" required />
                    </div>
                    <button type="submit" class="btn btn-success">إيداع</button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-danger">خصم رصيد</h6>
            </div>
            <div class="card-body">
                <form action="/Admin/WalletDebit" method="post">
                    <input type="hidden" name="userId" value="@user.Id" />
                    <div class="form-group">
                        <label>المبلغ</label>
                        <input type="number" step="0.01" class="form-control" name="amount" required min="1" />
                    </div>
                    <div class="form-group">
                        <label>السبب</label>
                        <input type="text" class="form-control" name="reason" required />
                    </div>
                    <button type="submit" class="btn btn-danger">خصم</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">سجل المعاملات (آخر 50)</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>النوع</th>
                        <th>المبلغ</th>
                        <th>الوصف</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model)
                    {
                        <tr>
                            <td>@tx.CreatedAt.ToString("g")</td>
                            <td>
                                @if (tx.Amount > 0)
                                {
                                    <span class="badge badge-success">إيداع</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">خصم</span>
                                }
                            </td>
                            <td class="@(tx.Amount > 0 ? "text-success" : "text-danger")">
                                @tx.Amount.ToString("C")
                            </td>
                            <td>@tx.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
