@model IEnumerable<Uis.Server.Models.User>
@{
    ViewData["Title"] = "إدارة المحافظ";
}

<div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
    <div class="flex justify-between items-center mb-8">
        <h3 class="text-xl font-black text-gray-800">المحافظ المالية للمستخدمين</h3>
    </div>

    <form method="get" class="mb-8">
        <div class="flex gap-4">
            <input type="text" class="flex-1 bg-gray-50 border border-gray-200 rounded-2xl px-6 py-3 text-sm focus:outline-none focus:border-indigo-500 transition-all" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="ابحث بالاسم أو البريد..." />
            <button class="bg-indigo-600 text-white px-8 py-3 rounded-2xl font-black text-sm hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100" type="submit">بحث</button>
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full text-right">
            <thead>
                <tr class="text-[10px] font-black text-gray-400 uppercase tracking-widest border-b border-gray-50">
                    <th class="pb-4 px-4">المستخدم</th>
                    <th class="pb-4 px-4">البريد</th>
                    <th class="pb-4 px-4 text-center">الرصيد</th>
                    <th class="pb-4 px-4 text-left">الإجراءات</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                @foreach (var item in Model)
                {
                    <tr class="group hover:bg-indigo-50/30 transition-all">
                        <td class="py-5 px-4 font-bold text-gray-800">@item.FullName</td>
                        <td class="py-5 px-4 text-sm text-gray-500">@item.Email</td>
                        <td class="py-5 px-4 text-center">
                            <span class="bg-green-50 text-green-600 px-4 py-1.5 rounded-full font-black text-xs">@item.WalletBalance.ToString("N2") ج.م</span>
                        </td>
                        <td class="py-5 px-4 text-left">
                            <a href="/Admin/WalletDetails/@item.Id" class="text-indigo-600 hover:text-indigo-800 font-black text-xs bg-indigo-50 px-4 py-2 rounded-xl transition-all">التفاصيل</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
