@model IEnumerable<Uis.Server.Models.User>
@{
    ViewData["Title"] = "إدارة المحافظ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 text-gray-800">إدارة المحافظ المالية</h2>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">المحافظ المالية للمستخدمين</h6>
    </div>
    <div class="card-body">
        <form method="get" class="mb-4">
            <div class="input-group">
                <input type="text" class="form-control" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="ابحث بالاسم أو البريد..." />
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit">بحث</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>المستخدم</th>
                        <th>البريد</th>
                        <th>الرصيد</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td class="font-weight-bold text-success">@item.WalletBalance.ToString("C")</td>
                            <td>
                                <a href="/Admin/WalletDetails/@item.Id" class="btn btn-sm btn-info">عرض التفاصيل</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
