@model IEnumerable<Uis.Server.Models.WithdrawalRequest>
@{
    ViewData["Title"] = "إدارة طلبات السحب";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4" dir="rtl">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">طلبات سحب الرصيد</h5>
                    <div class="btn-group">
                        <a href="@Url.Action("Withdrawals")" class="btn btn-outline-secondary btn-sm @(string.IsNullOrEmpty(ViewBag.Status) ? "active" : "")">الكل</a>
                        <a href="@Url.Action("Withdrawals", new { status = "Pending" })" class="btn btn-outline-warning btn-sm @(ViewBag.Status == "Pending" ? "active" : "")">قيد الانتظار</a>
                        <a href="@Url.Action("Withdrawals", new { status = "Approved" })" class="btn btn-outline-success btn-sm @(ViewBag.Status == "Approved" ? "active" : "")">مقبولة</a>
                        <a href="@Url.Action("Withdrawals", new { status = "Rejected" })" class="btn btn-outline-danger btn-sm @(ViewBag.Status == "Rejected" ? "active" : "")">مرفوضة</a>
                    </div>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mx-4 mt-3">@TempData["Error"]</div>
                    }
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr class="bg-light">
                                    <th class="text-secondary text-xs font-weight-bold opacity-7 ps-4">المنفذ</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">المبلغ</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">التاريخ</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">الحالة</th>
                                    <th class="text-secondary text-xs font-weight-bold opacity-7">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex px-2 py-1">
                                                <div>
                                                    <img src="@(string.IsNullOrEmpty(item.Executor.ProfilePicture) ? "/img/default-avatar.png" : item.Executor.ProfilePicture)" class="avatar avatar-sm me-3 border-radius-lg" alt="user">
                                                </div>
                                                <div class="d-flex flex-column justify-content-center">
                                                    <h6 class="mb-0 text-sm">@item.Executor.FullName</h6>
                                                    <p class="text-xs text-secondary mb-0">@item.Executor.Email</p>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <p class="text-sm font-weight-bold mb-0">@item.Amount.ToString("N2") ج.م</p>
                                        </td>
                                        <td>
                                            <span class="text-secondary text-xs font-weight-bold">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                        </td>
                                        <td>
                                            @if (item.Status == "Pending")
                                            {
                                                <span class="badge badge-sm bg-gradient-warning">قيد الانتظار</span>
                                            }
                                            else if (item.Status == "Approved")
                                            {
                                                <span class="badge badge-sm bg-gradient-success">تم القبول</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-sm bg-gradient-danger">مرفوض</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-link text-primary font-weight-bold text-xs" data-bs-toggle="modal" data-bs-target="#modal-@item.Id">
                                                عرض التفاصيل
                                            </button>

                                            <!-- Modal -->
                                            <div class="modal fade" id="modal-@item.Id" tabindex="-1" role="dialog">
                                                <div class="modal-dialog modal-dialog-centered" role="document">
                                                    <div class="modal-content border-0">
                                                        <div class="modal-header bg-primary text-white border-0">
                                                            <h5 class="modal-title text-white">تفاصيل طلب السحب</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form action="@Url.Action("ResolveWithdrawal", new { id = item.Id })" method="post" enctype="multipart/form-data">
                                                            <div class="modal-body p-4">
                                                                <div class="text-center mb-4">
                                                                    <p class="text-secondary mb-1">المبلغ المطلوب</p>
                                                                    <h3 class="fw-bold text-dark">@item.Amount.ToString("N2") ج.م</h3>
                                                                    <p class="text-xs text-muted">رصيد المنفذ الحالي: @item.Executor.WalletBalance.ToString("N2") ج.م</p>
                                                                </div>
                                                                
                                                                <div class="mb-3">
                                                                    <label class="form-label text-sm fw-bold">المرفق من المنفذ (رقم المحفظة/الطلب)</label>
                                                                    <div class="border rounded p-2 text-center bg-light">
                                                                        @if (!string.IsNullOrEmpty(item.ScreenshotUrl))
                                                                        {
                                                                            <a href="@item.ScreenshotUrl" target="_blank">
                                                                                <img src="@item.ScreenshotUrl" class="img-fluid rounded shadow-sm" style="max-height: 200px;" alt="Screenshot">
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted text-xs">لا يوجد مرفق</span>
                                                                        }
                                                                    </div>
                                                                </div>

                                                                @if (item.Status == "Pending")
                                                                {
                                                                    <div class="mb-3">
                                                                        <label class="form-label text-sm fw-bold">إرفاق إثبات التحويل (سكرين شوت التحويل)</label>
                                                                        <input type="file" name="proof" class="form-control" accept="image/*" />
                                                                        <p class="text-xs text-muted mt-1">يجب إرفاق صورة التحويل عند قبول الطلب</p>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label text-sm fw-bold">ملاحظات الإدارة</label>
                                                                        <textarea name="adminNotes" class="form-control" rows="2" placeholder="اكتب ملاحظاتك هنا..."></textarea>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    @if (!string.IsNullOrEmpty(item.AdminProofUrl))
                                                                    {
                                                                        <div class="mb-3">
                                                                            <label class="form-label text-sm fw-bold">إثبات التحويل من الإدارة</label>
                                                                            <div class="border rounded p-2 text-center bg-light">
                                                                                <a href="@item.AdminProofUrl" target="_blank">
                                                                                    <img src="@item.AdminProofUrl" class="img-fluid rounded shadow-sm" style="max-height: 200px;" alt="Admin Proof">
                                                                                </a>
                                                                            </div>
                                                                        </div>
                                                                    }

                                                                    <div class="alert alert-light border">
                                                                        <p class="text-xs mb-1 fw-bold">ملاحظات الإدارة:</p>
                                                                        <p class="text-sm mb-0">@(string.IsNullOrEmpty(item.AdminNotes) ? "لا توجد ملاحظات" : item.AdminNotes)</p>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                                                                @if (item.Status == "Pending")
                                                                {
                                                                    <button type="submit" name="status" value="Rejected" class="btn btn-danger">رفض الطلب</button>
                                                                    <button type="submit" name="status" value="Approved" class="btn btn-success">قبول وتحويل</button>
                                                                }
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
